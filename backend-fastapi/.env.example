# App
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/custherds

# Token
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","https://partners-custherds.ourtestcloud.my.id"]

# Swagger Basic Auth
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=qwert12345!

# Xendit Payment Gateway
# Get your keys from https://dashboard.xendit.co/settings/developers#api-keys
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxxxx
# Get webhook token from https://dashboard.xendit.co/settings/developers#webhooks
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-verification-token

# Cloudflare R2 Storage
# Dapatkan Account ID dari: https://dash.cloudflare.com/ → kanan bawah halaman utama
R2_ACCOUNT_ID=your-cloudflare-account-id
# Buat API Token dari: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Nama bucket R2 yang sudah dibuat
R2_BUCKET_NAME=custherds-uploads
# Public URL bucket (aktifkan Public Access di R2 dashboard, atau gunakan custom domain)
# Contoh: https://uploads.custherds.com  atau  https://pub-xxxx.r2.dev
R2_PUBLIC_URL=https://uploads.yourdomain.com
